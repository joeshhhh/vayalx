# ── VAYALX Backend Environment Configuration (Example) ──
# Copy this file to .env and configure for your environment.

# Server Configuration
PORT=5000
NODE_ENV=development

# Client / Frontend URL (Allowed for CORS)
CLIENT_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/vayalx

# Security & JWT Authentication (Phase 3)
JWT_SECRET=replace_with_a_secure_random_string_in_production_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret_string
AUTH_COOKIE_NAME=vayalx_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Admin Initial Credentials (Optional for Seed)
ADMIN_EMAIL=admin@vayalx.demo
ADMIN_PASSWORD=AdminSecurePass2026!
ADMIN_MOBILE=9876543299
ADMIN_NAME=VAYALX Platform Admin

# External Services (Phase 5: Real Gemini AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_MODE=LIVE

# External Services (Phase 6)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
MARKET_MODE=DEMO
MARKET_API_URL=
MARKET_API_KEY=
SCHEMES_MODE=DEMO
SCHEMES_API_URL=
SCHEMES_API_KEY=
EXTERNAL_API_TIMEOUT_MS=8000
WEATHER_CACHE_TTL_MS=600000
MARKET_CACHE_TTL_MS=1800000
SCHEMES_CACHE_TTL_MS=86400000
