# ==========================================
# VAYALX - Environment Configuration (Phase 7)
# ==========================================
# WARNING: DO NOT commit your actual .env file.
# Copy this file to .env and fill in the values.

# ── Server Configuration ──
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ── MongoDB Database ──
MONGODB_URI=mongodb://localhost:27017/vayalx

# ── Authentication & Security ──
# REQUIRED: Must be a long, strong random string
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret_here
AUTH_COOKIE_NAME=vayalx_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── Gemini AI Services ──
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# Options: LIVE, DEMO
AI_MODE=DEMO
AI_REQUEST_TIMEOUT_MS=25000

# ── Market Data ──
# Options: LIVE, DEMO
MARKET_MODE=DEMO
MARKET_API_URL=https://api.data.gov.in/resource/unknown
MARKET_API_KEY=your_data_gov_in_api_key_here
MARKET_CACHE_TTL_MS=1800000

# ── Government Schemes ──
# Options: LIVE, DEMO
SCHEMES_MODE=DEMO
SCHEMES_API_URL=https://api.myscheme.gov.in/unknown
SCHEMES_API_KEY=
SCHEMES_CACHE_TTL_MS=86400000

# ── Weather Data (Open-Meteo) ──
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_CACHE_TTL_MS=600000

# ── General Limits ──
EXTERNAL_API_TIMEOUT_MS=8000
